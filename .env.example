# 主对话：选择供应商后填写其实际可用的模型 ID。
# openai / anthropic / deepseek / qwen / openai-compatible
LLM_PROVIDER=openai-compatible
LLM_MODEL_NAME=your-model-id
LLM_API_KEY=
# 留空使用供应商默认端点；自定义网关在此填写完整 API base URL。
LLM_BASE_URL=
LLM_TIMEOUT=30
LLM_MAX_RETRIES=0
LLM_MAX_TOKENS=4096
LLM_CONTEXT_WINDOW=32768

# 可选供应商专属密钥，只读取选中供应商的变量。
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=
# QWEN_API_KEY=

# 可选推理设置，需确认所选模型支持；未填写时不发送推理开关。
# LLM_REASONING_EFFORT=high
# LLM_THINKING_BUDGET=2048
# LLM_TEMPERATURE=0.7

# 记忆任务：全不填写则共用主模型；启用后需要独立完整配置。
# MEMORY_LLM_PROVIDER=deepseek
# MEMORY_LLM_MODEL_NAME=your-memory-model-id
# MEMORY_LLM_API_KEY=
# MEMORY_LLM_BASE_URL=
# MEMORY_LLM_MAX_TOKENS=4096

# LaMemory 检索：默认 keyword；显式 hybrid 才构造 embedding 客户端。
LAMEMORY_RETRIEVAL_MODE=keyword
LAMEMORY_RERANK_ENABLED=false
# 模型和维度须按实际服务填写，不自动选择模型。
# LAMEMORY_EMBEDDING_PROVIDER=openai-compatible
# LAMEMORY_EMBEDDING_MODEL=your-embedding-model
# LAMEMORY_EMBEDDING_BASE_URL=https://your-embedding-endpoint.example/v1
# LAMEMORY_EMBEDDING_DIMENSIONS=1024
# LAMEMORY_EMBEDDING_NAMESPACE=deployment-v1
# LAMEMORY_EMBEDDING_API_KEY=
# LAMEMORY_EMBEDDING_SEND_DIMENSIONS=false
# LAMEMORY_EMBEDDING_QUERY_PREFIX=
# LAMEMORY_EMBEDDING_DOCUMENT_PREFIX=
# LAMEMORY_EMBEDDING_TIMEOUT=10
# LAMEMORY_EMBEDDING_MAX_RETRIES=0
# LAMEMORY_SEMANTIC_MIN_SIMILARITY=0.3
# LAMEMORY_ALLOW_KEYWORD_FALLBACK=true
# LAMEMORY_MAX_EMBEDDING_CHARS=12000
# 重排使用独立完整配置；不继承聊天模型或其密钥。
# LAMEMORY_RERANK_LLM_PROVIDER=openai-compatible
# LAMEMORY_RERANK_LLM_MODEL_NAME=your-rerank-model
# LAMEMORY_RERANK_LLM_BASE_URL=https://your-chat-endpoint.example/v1
# LAMEMORY_RERANK_LLM_API_KEY=
# LAMEMORY_RERANK_LLM_TIMEOUT=5
# LAMEMORY_RERANK_LLM_MAX_RETRIES=0
